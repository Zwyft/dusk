@namespace url("uric://rcss.org/2.0");

.tracker-window {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    padding: 0dp;
}

.tracker-sections {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-height: 0;
    min-width: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 8dp 4dp 12dp 4dp;
    gap: 10dp;
}

.tracker-category {
    display: flex;
    flex-direction: column;
    gap: 6dp;
    padding: 6dp 6dp 8dp 6dp;
    border-radius: 8dp;
    background: rgba(11, 18, 31, 0.40);
}

.tracker-category-title {
    font-family: "AlegreyaSC";
    font-size: 14dp;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #f6e9c5;
    padding-left: 2dp;
}

.tracker-grid {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8dp;
    align-items: flex-start;
}

.tracker-card {
    width: 56dp;
    height: 56dp;
    padding: 0;
    border: 1dp solid rgba(255, 255, 255, 0.10);
    border-radius: 6dp;
    background: linear-gradient(to bottom, rgba(255, 255, 255, 0.08), rgba(0, 0, 0, 0.18));
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 0;
    box-shadow: 0 1dp 2dp rgba(0, 0, 0, 0.35);
    transition: transform 0.08s ease, opacity 0.08s ease, filter 0.08s ease;
}

.tracker-card:hover {
    transform: scale(1.04);
}

.tracker-card.locked {
    opacity: 0.62;
    filter: grayscale(100%) brightness(0.76) contrast(0.94);
}

.tracker-card.owned {
    opacity: 1;
    filter: none;
    border: 1dp solid rgba(138, 225, 255, 0.55);
    background: linear-gradient(to bottom, rgba(100, 174, 255, 0.18), rgba(12, 28, 52, 0.24));
}

.tracker-card-icon {
    width: 52dp;
    height: 52dp;
    display: block;
    image-rendering: auto;
}

.tracker-card-placeholder {
    visibility: hidden;
    pointer-events: none;
}

.tracker-card-label {
    display: none;
}

.tracker-window icon {
    font-family: "MaterialSymbolsRounded";
    font-weight: normal;
    display: inline-block;
    vertical-align: middle;
}
