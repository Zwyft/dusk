@namespace url("uric://rcss.org/2.0");

.tracker-window {
    position: absolute;
    top: 24dp;
    right: 24dp;
    bottom: 24dp;
    left: 24dp;
    display: flex;
    justify-content: center;
    align-items: stretch;
    pointer-events: none;
}

.tracker-shell {
    width: 100%;
    max-width: 960dp;
    display: flex;
    flex-direction: column;
    gap: 4dp;
    padding: 16dp 18dp 18dp;
    border: 1dp solid rgba(255, 245, 195, 0.55);
    border-radius: 18dp;
    background: linear-gradient(180deg, rgba(95, 65, 123, 0.98), rgba(82, 56, 108, 0.98));
    box-shadow: 0 18dp 48dp rgba(0, 0, 0, 0.45), inset 0 0 0 1dp rgba(255, 255, 255, 0.05);
    pointer-events: auto;
    overflow: hidden;
}

.tracker-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12dp;
}

.tracker-titleblock {
    display: flex;
    flex-direction: column;
    gap: 0dp;
}

.tracker-kicker {
    font-family: "Fira Sans Condensed";
    font-size: 11dp;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(255, 244, 196, 0.95);
    margin-left: 2dp;
}

.tracker-titleblock h1 {
    margin: 0;
    font-family: "AlegreyaSC";
    font-size: 26dp;
    font-weight: bold;
    color: #fff7d5;
    text-transform: uppercase;
    line-height: 1;
}

.tracker-status {
    font-size: 11dp;
    color: rgba(255, 243, 214, 0.78);
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.tracker-close {
    width: 38dp;
    height: 38dp;
    padding: 0;
    border: 0;
    border-radius: 10dp;
    background: rgba(255, 255, 255, 0.08);
    color: #fff6da;
    display: flex;
    align-items: center;
    justify-content: center;
}

.tracker-close:hover {
    background: rgba(255, 255, 255, 0.16);
}

.tracker-summary-row {
    display: none;
}

.tracker-sections {
    display: block;
    overflow-y: auto;
    padding: 10dp 6dp 0dp 0dp;
}

.tracker-grid {
    display: grid;
    grid-template-columns: repeat(4, 56dp);
    justify-content: start;
    align-content: start;
    gap: 10dp 10dp;
}

.tracker-card {
    width: 56dp;
    height: 56dp;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.08s ease, opacity 0.08s ease, filter 0.08s ease;
}

.tracker-card:hover {
    transform: scale(1.04);
}

.tracker-card.locked {
    opacity: 0.55;
    filter: grayscale(100%) brightness(0.72) contrast(0.92);
}

.tracker-card.owned {
    opacity: 1;
    filter: none;
}

.tracker-card-icon {
    width: 56dp;
    height: 56dp;
    image-rendering: auto;
}

.tracker-card-label {
    display: none;
}

.tracker-window icon {
    font-family: "MaterialSymbolsRounded";
    font-weight: normal;
    display: inline-block;
    vertical-align: middle;
}
