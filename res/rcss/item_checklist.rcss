@namespace url("uric://rcss.org/2.0");

body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: #d9d6cc;
    font-family: "Fira Sans";
}

.tracker-window {
    position: absolute;
    top: 24dp;
    right: 24dp;
    bottom: 24dp;
    left: 24dp;
    display: flex;
    justify-content: center;
    align-items: stretch;
    pointer-events: none;
}

.tracker-shell {
    width: 100%;
    max-width: 1280dp;
    display: flex;
    flex-direction: column;
    gap: 10dp;
    padding: 16dp 18dp 18dp;
    border: 1dp solid rgba(255, 245, 195, 0.55);
    border-radius: 18dp;
    background: linear-gradient(180deg, rgba(102, 72, 139, 0.98), rgba(92, 63, 128, 0.98));
    box-shadow: 0 18dp 48dp rgba(0, 0, 0, 0.45), inset 0 0 0 1dp rgba(255, 255, 255, 0.05);
    pointer-events: auto;
    overflow: hidden;
}

.tracker-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16dp;
}

.tracker-titleblock {
    display: flex;
    flex-direction: column;
    gap: 2dp;
}

.tracker-kicker {
    font-family: "Fira Sans Condensed";
    font-size: 11dp;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: rgba(255, 248, 214, 0.9);
    margin-left: 2dp;
}

.tracker-titleblock h1 {
    margin: 0;
    font-family: "AlegreyaSC";
    font-size: 28dp;
    font-weight: bold;
    color: #fff8df;
    text-transform: uppercase;
    line-height: 1;
}

.tracker-status {
    font-size: 12dp;
    color: rgba(255, 243, 214, 0.72);
    text-transform: uppercase;
    letter-spacing: 0.08em;
}

.tracker-close {
    width: 38dp;
    height: 38dp;
    padding: 0;
    border: 0;
    border-radius: 10dp;
    background: rgba(255, 255, 255, 0.08);
    color: #fff6da;
    display: flex;
    align-items: center;
    justify-content: center;
}

.tracker-close:hover {
    background: rgba(255, 255, 255, 0.16);
}

.tracker-summary-row {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 4dp 8dp 0dp;
    border-radius: 0;
    background: transparent;
}

.tracker-summary-meta {
    display: flex;
    align-items: center;
    font-family: "Fira Sans Condensed";
    font-size: 14dp;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 247, 224, 0.92);
}

.tracker-progress {
    display: none;
}

.tracker-progress-fill {
    width: 0%;
    height: 100%;
    border-radius: 999dp;
    background: linear-gradient(90deg, #7bd66b, #cbe56c);
    box-shadow: 0 0 14dp rgba(138, 220, 105, 0.45);
}

.tracker-sections {
    display: block;
    overflow-y: auto;
    padding-right: 8dp;
}

.tracker-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(56dp, 56dp));
    justify-content: start;
    align-content: start;
    gap: 14dp 14dp;
}

.tracker-card {
    width: 56dp;
    height: 56dp;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.08s ease, opacity 0.08s ease, filter 0.08s ease;
}

.tracker-card:hover {
    transform: scale(1.04);
}

.tracker-card.locked {
    opacity: 0.5;
    filter: grayscale(100%);
}

.tracker-card.owned {
    opacity: 1;
    filter: none;
}

.tracker-card-icon {
    width: 56dp;
    height: 56dp;
    image-rendering: auto;
    object-fit: contain;
}

.tracker-card-label {
    display: none;
}

icon {
    font-family: "MaterialSymbolsRounded";
    font-weight: normal;
    display: inline-block;
    vertical-align: middle;
}
